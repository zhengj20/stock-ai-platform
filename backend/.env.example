# 环境变量配置
# SECRET_KEY 必填：JWT 签名密钥，丢失/泄露后所有 token 将失效
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-random-48-char-string
REDIS_URL=redis://localhost:6379/0
# 生产环境建议设为 true：Redis 不可用时阻止启动，避免缓存降级导致性能雪崩
# 本地开发保持 false：Redis 不可用时自动降级为内存缓存
REDIS_REQUIRED=false
DEBUG=true
LOG_LEVEL=INFO
